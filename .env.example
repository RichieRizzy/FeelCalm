# Copy to .env (or set these in your host's dashboard). Everything is optional for local testing.
PORT=3000
# Where the SQLite database lives. Put this on a persistent disk in production.
DATA_DIR=./data
# The public https address of your app, no trailing slash. Needed so Paystack can send people back.
PUBLIC_URL=https://feelcalm.example.com
# Long random string used to sign logins. If empty, one is generated and stored in the database.
JWT_SECRET=
# Leave both empty to run payments in TEST mode (no real money moves).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Address search is limited to this country (2-letter code).
COUNTRY_CODE=ng
# How close (metres) a rider must be to the pickup or drop-off to confirm it. 0 turns the check off.
GEOFENCE_M=400
# Shown to the address-search provider as the contact for this app.
CONTACT_EMAIL=support@feelcalm.app
